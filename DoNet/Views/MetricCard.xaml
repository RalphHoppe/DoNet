<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DoNet.Views.MetricCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DoNet.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- One labelled statistic inside the System Information panel. -->
    <Border Padding="14,15,14,16"
            Background="{StaticResource MetricCardBackgroundBrush}"
            BorderBrush="{StaticResource MetricCardBorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <StackPanel>
            <TextBlock CharacterSpacing="110"
                       FontFamily="{StaticResource OutfitMedium}"
                       FontSize="10.5"
                       Foreground="{StaticResource TextLabelBrush}"
                       Text="{x:Bind Caption, Mode=OneWay}" />
            <TextBlock Margin="0,7,0,0"
                       FontFamily="{StaticResource OutfitSemiBold}"
                       FontSize="15.5"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Text="{x:Bind Value, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Margin="0,5,0,0"
                       FontFamily="{StaticResource OutfitRegular}"
                       FontSize="12"
                       Foreground="{StaticResource TextTertiaryBrush}"
                       Text="{x:Bind Detail, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</UserControl>
