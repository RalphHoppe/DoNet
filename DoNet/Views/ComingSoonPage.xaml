<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DoNet.Views.ComingSoonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DoNet.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Placeholder for the shell sections that haven't been designed yet. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="68"
                Height="68"
                HorizontalAlignment="Center"
                Background="{StaticResource BrandTealSoftBrush}"
                BorderBrush="{StaticResource BrandTealEdgeBrush}"
                BorderThickness="1"
                CornerRadius="22">
            <FontIcon x:Name="SectionIcon"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                      FontSize="26"
                      Foreground="{StaticResource BrandTealBrush}"
                      Glyph="&#xE8B7;" />
        </Border>

        <TextBlock x:Name="SectionTitle"
                   Margin="0,24,0,0"
                   HorizontalAlignment="Center"
                   FontFamily="{StaticResource OutfitBold}"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="Work" />

        <TextBlock x:Name="SectionMessage"
                   MaxWidth="420"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   FontFamily="{StaticResource OutfitRegular}"
                   FontSize="15"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="This section hasn't been built yet."
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
    </StackPanel>
</Page>
