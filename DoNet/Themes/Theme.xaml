<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DoNet design tokens.
        Everything visual in the app resolves back to one of the brushes,
        font families or sizes declared here.
    -->

    <!-- ============================ Palette ============================ -->

    <Color x:Key="BrandTealColor">#4FBCA1</Color>
    <Color x:Key="BrandTealHoverColor">#5CCBAF</Color>
    <Color x:Key="BrandTealPressedColor">#3FA389</Color>
    <Color x:Key="BrandTealDeepColor">#1E6D5F</Color>
    <Color x:Key="SurfaceDeepColor">#06100F</Color>

    <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTealColor}" />
    <SolidColorBrush x:Key="BrandTealHoverBrush" Color="{StaticResource BrandTealHoverColor}" />
    <SolidColorBrush x:Key="BrandTealPressedBrush" Color="{StaticResource BrandTealPressedColor}" />
    <SolidColorBrush x:Key="BrandTealSoftBrush" Color="{StaticResource BrandTealColor}" Opacity="0.14" />
    <SolidColorBrush x:Key="BrandTealEdgeBrush" Color="{StaticResource BrandTealColor}" Opacity="0.30" />
    <SolidColorBrush x:Key="LinkBrush" Color="#63C6B0" />

    <!-- Window / page backdrop (sits under the starfield image). -->
    <SolidColorBrush x:Key="WindowBackdropBrush" Color="{StaticResource SurfaceDeepColor}" />

    <!-- ============================ Text ============================ -->

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F7F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A9BEB9" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A9D98" />
    <SolidColorBrush x:Key="TextLabelBrush" Color="#93A6A1" />
    <SolidColorBrush x:Key="TextPlaceholderBrush" Color="#7E918D" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F2846F" />

    <!-- ============================ Glass surfaces ============================ -->

    <!-- The sign-in card: a barely-there white wash with a vertical lift. -->
    <LinearGradientBrush x:Key="CardBackgroundBrush" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Offset="0.0" Color="#1AFFFFFF" />
        <GradientStop Offset="0.55" Color="#12FFFFFF" />
        <GradientStop Offset="1.0" Color="#0BFFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Offset="0.0" Color="#2EFFFFFF" />
        <GradientStop Offset="0.5" Color="#1AFFFFFF" />
        <GradientStop Offset="1.0" Color="#14FFFFFF" />
    </LinearGradientBrush>

    <!-- Inputs. -->
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="FieldBackgroundHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="FieldBackgroundFocusedBrush" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="FieldBorderHoverBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="FieldIconBrush" Color="#8DA09B" />

    <!-- Title bar. -->
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="TitleBarPressedBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="TitleBarClosePressedBrush" Color="#9E2318" />
    <SolidColorBrush x:Key="TitleBarSeparatorBrush" Color="#1FFFFFFF" />

    <!-- ============================ Typography ============================ -->

    <FontFamily x:Key="OutfitRegular">/Assets/Fonts/Outfit-Regular.ttf#Outfit</FontFamily>
    <FontFamily x:Key="OutfitMedium">/Assets/Fonts/Outfit-Medium.ttf#Outfit Medium</FontFamily>
    <FontFamily x:Key="OutfitSemiBold">/Assets/Fonts/Outfit-SemiBold.ttf#Outfit SemiBold</FontFamily>
    <FontFamily x:Key="OutfitBold">/Assets/Fonts/Outfit-Bold.ttf#Outfit</FontFamily>

    <x:Double x:Key="DisplayFontSize">34</x:Double>
    <x:Double x:Key="WordmarkFontSize">25</x:Double>
    <x:Double x:Key="BodyFontSize">15</x:Double>
    <x:Double x:Key="FieldFontSize">15</x:Double>
    <x:Double x:Key="ButtonFontSize">16</x:Double>
    <x:Double x:Key="SmallFontSize">14</x:Double>
    <x:Double x:Key="CaptionFontSize">13</x:Double>
    <x:Double x:Key="LabelFontSize">11.5</x:Double>

    <!-- ============================ Metrics ============================ -->

    <x:Double x:Key="CardWidth">480</x:Double>
    <CornerRadius x:Key="CardCornerRadius">24</CornerRadius>
    <CornerRadius x:Key="FieldCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">12</CornerRadius>
    <x:Double x:Key="FieldHeight">46</x:Double>
    <x:Double x:Key="PrimaryButtonHeight">52</x:Double>
    <x:Double x:Key="TitleBarHeight">48</x:Double>

    <!-- Soft drop shadow lifting the sign-in card off the starfield. -->
    <ThemeShadow x:Key="CardShadow" />

    <!--
        ============================ Text input chrome ============================
        WinUI's stock TextBox / PasswordBox paint their own background, border and
        focus underline. The card draws its own field chrome, so every stock layer
        is neutralised here and the controls render as bare text.
    -->

    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
    <Thickness x:Key="TextControlThemePadding">0</Thickness>

    <SolidColorBrush x:Key="TextControlForeground" Color="#F2F7F5" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F2F7F5" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F2F7F5" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#6C7B78" />

    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7E918D" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8CA09B" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8CA09B" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundDisabled" Color="#5F6D6A" />

    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{StaticResource BrandTealColor}" />

    <!-- Inline clear ("x") button inside the TextBox. -->
    <SolidColorBrush x:Key="TextControlButtonBackground" Color="Transparent" />
    <SolidColorBrush x:Key="TextControlButtonBackgroundPointerOver" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="TextControlButtonBackgroundPressed" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TextControlButtonForeground" Color="#8DA09B" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPointerOver" Color="#F2F7F5" />
    <SolidColorBrush x:Key="TextControlButtonForegroundPressed" Color="#D6E2DF" />

</ResourceDictionary>
